<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <vendor>TuxFlash</vendor>
  <action id="org.tuxflash.TuxFlash.write-image">
    <description>Write a disk image with TuxFlash</description>
    <message>Authorization is required to modify the selected USB device</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tuxflash-helper</annotate>
  </action>
</policyconfig>
